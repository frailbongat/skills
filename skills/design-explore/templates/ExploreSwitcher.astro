---
// Dev-only design switcher, copied in by the design-explore skill.
// `/design-explore lock` deletes this folder once no exploration is left.
//
// It lists every <Explore> on the page as buttons in an always-open bar, so a
// switch is one click. The bar is a row at the bottom center when it fits the
// window, and a column at the bottom right when it does not. `[` and `]` step
// to the previous and next variant of the exploration clicked last, or the
// first one. A pick rewrites `?variant=` and reloads, so the new variant's
// scripts and entrance motion run the way they do on a first visit. The script
// is inline, so production builds ship none of it.

const IS_DEV = import.meta.env.DEV;
---

{
  IS_DEV && (
    <script is:inline>
      (() => {
        const PARAM = "variant";
        // Remembers the exploration clicked last across the reload a pick makes.
        const KEYED = "design-explore:keyed";
        const EDGE = 16;
        const explorations = [...document.querySelectorAll("[data-explore]")].map((element) => ({
          target: element.getAttribute("data-explore"),
          ids: (element.getAttribute("data-explore-ids") ?? "").split(" ").filter(Boolean),
        }));
        if (explorations.length === 0) return;

        const params = new URLSearchParams(location.search);
        const picks = {};
        for (const value of params.getAll(PARAM)) {
          const colon = value.indexOf(":");
          if (colon === -1) picks["*"] ??= value;
          else picks[value.slice(0, colon)] = value.slice(colon + 1);
        }
        const resolve = (exploration) => {
          const wanted = picks[exploration.target] ?? picks["*"];
          return exploration.ids.includes(wanted) ? wanted : exploration.ids[0];
        };

        const go = (target, id) => {
          sessionStorage.setItem(KEYED, target);
          picks[target] = id;
          const next = new URLSearchParams(location.search);
          next.delete(PARAM);
          const scoped = explorations.length > 1;
          for (const exploration of explorations) {
            const chosen = resolve(exploration);
            if (chosen === exploration.ids[0]) continue;
            next.append(PARAM, scoped ? `${exploration.target}:${chosen}` : chosen);
          }
          const query = next.toString();
          location.assign(`${location.pathname}${query ? `?${query}` : ""}${location.hash}`);
        };

        const keyed =
          explorations.find((exploration) => exploration.target === sessionStorage.getItem(KEYED)) ??
          explorations[0];

        addEventListener("keydown", (event) => {
          if (event.key !== "[" && event.key !== "]") return;
          if (event.repeat || event.metaKey || event.ctrlKey || event.altKey || event.isComposing) return;
          const focused = event.target;
          if (focused instanceof HTMLElement && (focused.isContentEditable || focused.matches("input, textarea, select"))) return;
          event.preventDefault();
          const ids = keyed.ids;
          const index = ids.indexOf(resolve(keyed));
          go(keyed.target, ids[(index + (event.key === "]" ? 1 : -1) + ids.length) % ids.length]);
        });

        // Neutral chrome on purpose: the switcher is a tool, not part of the design.
        const font = 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif';
        const make = (tag, css, text) => {
          const element = document.createElement(tag);
          element.style.cssText = css;
          if (text !== undefined) element.textContent = text;
          return element;
        };

        const root = make("div", "");
        root.setAttribute("role", "toolbar");
        root.setAttribute("aria-label", "Design variants");
        root.title = "Press [ or ] to switch variants";
        const groups = [];

        for (const exploration of explorations) {
          const chosen = resolve(exploration);
          const group = make("div", "");
          group.setAttribute("role", "group");
          group.setAttribute("aria-label", exploration.target);
          group.append(
            make(
              "span",
              `padding:4px 8px;color:${exploration === keyed ? "#a3a3a3" : "#737373"};font:600 11px/1.3 ${font};letter-spacing:.04em;text-transform:uppercase;white-space:nowrap`,
              exploration.target,
            ),
          );
          for (const id of exploration.ids) {
            const active = id === chosen;
            const option = make(
              "button",
              `padding:6px 10px;border:0;border-radius:8px;background:${active ? "#404040" : "transparent"};color:${active ? "#fff" : "#d4d4d4"};font:500 13px/1.3 ${font};text-align:left;white-space:nowrap;cursor:pointer`,
              id,
            );
            option.type = "button";
            option.setAttribute("aria-pressed", String(active));
            option.addEventListener("click", () => go(exploration.target, id));
            group.append(option);
          }
          groups.push(group);
          root.append(group);
        }

        const base = `position:fixed;bottom:${EDGE}px;z-index:2147483647;display:flex;flex-direction:column;gap:2px;padding:4px;border-radius:12px;background:#171717;box-shadow:0 8px 30px rgba(0,0,0,.35)`;
        const setLayout = (row) => {
          root.style.cssText = row
            ? `${base};left:50%;transform:translateX(-50%);width:max-content`
            : `${base};right:${EDGE}px;max-height:calc(100vh - ${2 * EDGE}px);overflow-y:auto`;
          root.setAttribute("aria-orientation", row ? "horizontal" : "vertical");
          for (const group of groups) {
            group.style.cssText = `display:flex;gap:2px;${row ? "align-items:center" : "flex-direction:column"}`;
          }
        };

        document.body.append(root);
        // The row's width, measured once, decides the layout on every resize.
        setLayout(true);
        const rowWidth = root.offsetWidth;
        const fit = () => setLayout(rowWidth <= innerWidth - 2 * EDGE);
        fit();
        addEventListener("resize", fit);
      })();
    </script>
  )
}
